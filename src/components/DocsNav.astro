---
const base = import.meta.env.BASE_URL;
const links = [
  ['getting-started', 'Getting started'],
  ['collections', 'Working with collections'],
  ['team-harness', 'A harness for your team'],
  ['agents', 'Working with agents'],
  ['openclaw', 'Under OpenClaw'],
  ['commands', 'Command reference'],
];
---
<nav aria-label="Documentation">
  {links.map(([slug, title]) => <a href={`${base}docs/${slug}/`} aria-current={Astro.url.pathname === `${base}docs/${slug}/` ? 'page' : undefined}>{title}</a>)}
</nav>
