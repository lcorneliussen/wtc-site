---
import Base from './Base.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    author: string;
    updated: string;
    chapters: { id: string; title: string }[];
    milestones: {
      date: string;
      label: string;
      title: string;
      sources: { label: string; url: string }[];
    }[];
  };
}
const { frontmatter } = Astro.props;
const base = import.meta.env.BASE_URL;
const date = new Date(`${frontmatter.updated}T12:00:00Z`).toLocaleDateString('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
});
---
<Base title={`${frontmatter.title} | taba`} description={frontmatter.description}>
  <div class="story-progress" role="progressbar" aria-label="Reading progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-story-progress hidden><span></span></div>
  <main class="wrap story" id="main" data-story>
    <header class="story-header">
      <p class="eyebrow">The origin of taba</p>
      <h1>{frontmatter.title}<span class="brand-dot">.</span></h1>
      <p class="story-description">{frontmatter.description}</p>
      <p class="story-byline">By {frontmatter.author} <span aria-hidden="true">/</span> <time datetime={frontmatter.updated}>{date}</time></p>
      <p class="draft-label">First draft</p>
      <a class="story-begin" href="#story-start">Read the story <span aria-hidden="true">↓</span></a>
    </header>
    <div class="story-grid">
      <details class="story-nav" data-story-nav open>
        <summary>
          <span class="toc-heading"><span class="eyebrow">In this story</span><span class="story-nav-current" data-story-current hidden></span></span>
          <span class="story-position" data-story-position aria-hidden="true" hidden></span>
          <svg class="toc-chevron" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="m3 5 4 4 4-4" stroke="currentColor" stroke-width="1.5" /></svg>
        </summary>
        <nav aria-label="Story chapters">
          <ol>
            {frontmatter.chapters.map(chapter => <li><a href={`#${chapter.id}`}>{chapter.title}</a></li>)}
            <li><a href="#public-record">The public record</a></li>
          </ol>
        </nav>
      </details>
      <article class="story-content" aria-label={frontmatter.title} id="story-start">
        <div class="prose"><slot /></div>
        <section class="public-record" id="public-record" aria-labelledby="record-title">
          <h2 id="record-title">The public record</h2>
          <p class="record-note">The story above is my recollection. These links date public commits and design records. They do not date every decision. The work overlapped. Reviews were part of the CLI migration, and services developed alongside OpenClaw integration.</p>
          <ol class="record-list">
            {frontmatter.milestones.map(milestone => (
              <li>
                <time datetime={milestone.date}>{milestone.label}</time>
                <div>
                  <h3>{milestone.title}</h3>
                  <ul class="record-sources">
                    {milestone.sources.map(source => <li><a href={source.url}>{source.label}</a></li>)}
                  </ul>
                </div>
              </li>
            ))}
          </ol>
        </section>
        <div class="story-next">
          <a href={`${base}docs/collections/`}>How collections work <span aria-hidden="true">→</span></a>
          <a href={`${base}docs/getting-started/`}>Create a collection <span aria-hidden="true">→</span></a>
        </div>
      </article>
    </div>
  </main>
</Base>
<script>
  import '../scripts/story';
</script>
<style>
  .story-progress { position: fixed; inset: 0 0 auto; height: 3px; z-index: 30; pointer-events: none; background: var(--line); }
  .story-progress span { display: block; width: 100%; height: 100%; background: #718a49; transform: scaleX(var(--read-progress, 0)); transform-origin: left; }
  .story { max-width: 1100px; padding-block: 85px 100px; }
  .story-header { position: relative; max-width: 100%; padding-bottom: 55px; margin-bottom: 70px; border-bottom: 1px solid var(--line); }
  .story-header .eyebrow { margin-bottom: 20px; }
  h1 { font: 650 clamp(52px, 7.5vw, 96px)/1.08 var(--display); letter-spacing: -.06em; margin: 0 0 28px; }
  .story-description { max-width: 660px; font-size: 22px; line-height: 1.6; margin: 0 0 26px; }
  .story-byline { color: var(--muted); font-size: 12px; margin: 0; }
  .story-byline span { padding-inline: 9px; }
  .draft-label { display: inline-block; margin: 15px 0 0; padding: 4px 9px; border: 1px solid #c7d3b5; border-radius: 4px; color: var(--green); font: 11px/1.6 var(--mono); }
  .story-begin { display: inline-flex; align-items: center; gap: 15px; margin-left: 24px; font-size: 12px; text-decoration: underline; text-underline-offset: 4px; }
  .story-begin span { font-size: 18px; }
  .story-grid { display: grid; grid-template-columns: 180px minmax(0, 720px); gap: 70px; align-items: start; }
  .story-nav { position: sticky; top: 35px; }
  .story-nav summary { display: flex; align-items: center; gap: 12px; cursor: pointer; list-style: none; margin-bottom: 20px; }
  .story-nav summary::-webkit-details-marker { display: none; }
  .story-nav .eyebrow { display: block; font-size: 9px; letter-spacing: 1px; white-space: nowrap; margin: 0; }
  .toc-heading { min-width: 0; flex: 1; }
  .toc-chevron { flex: 0 0 auto; transition: transform .2s; }
  .story-nav[open] .toc-chevron { transform: rotate(180deg); }
  .story-position { font: 10px var(--mono); white-space: nowrap; color: var(--muted); }
  .story-nav-current { display: none; }
  .story-nav ol { padding-left: 20px; margin: 0; color: var(--muted); }
  .story-nav li { padding: 0 0 12px 5px; font-size: 12px; line-height: 1.6; }
  .story-nav li::marker { font: 10px var(--mono); }
  .story-nav a { display: block; border-left: 2px solid transparent; padding-left: 9px; margin-left: -11px; transition: color .2s, border-color .2s; }
  .story-nav a:hover { color: var(--green); text-decoration: underline; text-underline-offset: 3px; }
  .story-nav a[aria-current="location"] { color: var(--green); font-weight: 650; border-left-color: #819953; }
  .story-nav li:has(a[aria-current="location"])::marker { color: var(--green); }
  .story-content { min-width: 0; scroll-margin-top: 100px; }
  .prose { font-size: 17px; line-height: 1.85; }
  .prose :global(.story-intro > p:first-child) { margin-top: 0; font-size: 22px; line-height: 1.7; color: var(--ink); }
  .prose :global(.story-intro) { margin-bottom: 55px; }
  .prose :global(.chapter) { position: relative; padding-top: 44px; margin-top: 60px; display: flow-root; }
  .prose :global(.chapter::before) { content: ''; position: absolute; inset: 0 0 auto; height: 1px; background: var(--line); transform-origin: left; transition: transform .8s ease; }
  .story:global(.story-enhanced) .prose :global(.chapter::before) { transform: scaleX(.18); }
  .story:global(.story-enhanced) .prose :global(.chapter.is-seen::before) { transform: scaleX(1); }
  .prose :global(.chapter-number) { position: absolute; top: 50px; left: 0; margin: 0; font: 13px/1.7 var(--mono); color: #71834f; }
  .prose :global(h2) { font-size: 34px; line-height: 1.3; margin: 0 0 28px; padding-left: 55px; letter-spacing: -1.2px; scroll-margin-top: 100px; }
  .prose :global(pre) { margin-block: 28px; font-size: 13px; line-height: 1.8; }
  .prose :global(pre code) { font-size: inherit; }
  .prose :global(.collection-map) { margin: 30px 0; padding: 24px; border: 1px solid #cbd6bd; background: #eff3e7; border-radius: 10px; }
  .prose :global(.collection-owner) { padding-bottom: 19px; border-bottom: 1px solid #d3ddc7; }
  .prose :global(.collection-owner > span) { display: block; margin-bottom: 9px; font: 10px/1.6 var(--mono); color: var(--green); }
  .prose :global(.collection-owner code) { display: inline-block; padding: 2px 0; margin-right: 12px; background: none; font-size: 11px; }
  .prose :global(.collection-tasks) { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 21px; }
  .prose :global(.task-example) { min-width: 0; padding: 20px; background: var(--paper); border: 1px solid #d3ddc7; border-radius: 7px; }
  .prose :global(.task-example > span) { display: block; font: 10px var(--mono); color: var(--muted); }
  .prose :global(.task-example > strong) { display: block; font: 600 12px var(--mono); color: var(--ink); margin-top: 12px; }
  .prose :global(.task-example ul) { list-style: none; margin: 14px 0 0; padding: 0 0 0 14px; border-left: 1px solid #c6d0b9; }
  .prose :global(.task-example li) { line-height: 1.8; }
  .prose :global(.task-example code) { background: none; padding: 0; font-size: 11px; }
  .prose :global(.collection-map figcaption) { margin-top: 20px; color: #596b50; font-size: 12px; line-height: 1.8; }
  .prose :global(.story-aim) { margin-top: 30px; padding: 28px 30px; background: var(--lime); border-left: 3px solid #819953; font-size: 22px; line-height: 1.6; color: var(--ink); border-radius: 0 7px 7px 0; }
  .public-record { border-top: 1px solid var(--line); margin-top: 70px; padding-top: 45px; scroll-margin-top: 100px; }
  .public-record h2 { font-size: 30px; letter-spacing: -.9px; }
  .record-note { color: var(--muted); font-size: 14px; line-height: 1.8; margin-block: 20px 28px; }
  .record-list { list-style: none; margin: 0; padding: 0; }
  .record-list > li { position: relative; display: grid; grid-template-columns: 105px minmax(0, 1fr); gap: 20px; padding: 8px 0 34px 25px; border-left: 1px solid #c9d4bc; }
  .record-list > li::before { content: ''; position: absolute; left: -4px; top: 15px; width: 7px; height: 7px; border-radius: 50%; background: #819953; box-shadow: 0 0 0 4px var(--paper); }
  .record-list > li:last-child { padding-bottom: 6px; }
  .record-list time { font: 11px/1.8 var(--mono); color: var(--muted); padding-top: 3px; }
  .record-list h3 { margin: 0 0 9px; font-size: 16px; letter-spacing: -.3px; }
  .record-sources { list-style: none; padding: 0; margin: 0; }
  .record-sources li { margin-block: 5px; font-size: 13px; line-height: 1.7; }
  .record-sources a { text-decoration: underline; text-underline-offset: 3px; color: var(--green); }
  .story-next { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 20px; border-top: 1px solid var(--line); padding-top: 25px; margin-top: 25px; font-size: 13px; }
  .story-next a { text-decoration: underline; text-underline-offset: 4px; }
  .story-next span { margin-left: 8px; }
  @media (max-width: 1000px) {
    .story-grid { grid-template-columns: 160px minmax(0, 1fr); gap: 40px; }
  }
  @media (max-width: 800px) {
    .story { max-width: 740px; padding-block: 45px 65px; }
    .story-header { margin-bottom: 0; padding-bottom: 35px; border-bottom: 0; }
    .story-description { font-size: 20px; }
    .story-grid { display: block; }
    .story-nav { top: 3px; z-index: 10; border-block: 1px solid var(--line); padding-block: 17px; margin-bottom: 35px; background: var(--paper); }
    .story-nav summary { margin-bottom: 0; }
    .story-nav[open] summary { margin-bottom: 18px; }
    .story-nav-current { display: block; margin-top: 5px; font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .story-nav ol { columns: 2; column-gap: 32px; }
    .story-nav li { break-inside: avoid; }
    .prose { font-size: 16px; }
    .prose :global(.story-intro > p:first-child) { font-size: 20px; }
    .prose :global(h2) { font-size: 29px; padding-left: 43px; }
    .prose :global(.chapter) { margin-top: 48px; padding-top: 36px; }
    .prose :global(.chapter-number) { top: 41px; font-size: 11px; }
    .prose :global(.story-aim) { padding: 22px; font-size: 20px; }
  }
  @media (max-width: 420px) {
    .story-description { font-size: 18px; }
    .story-byline span { padding-inline: 4px; }
    .story-nav ol { columns: 1; }
    .story-nav li { padding-bottom: 9px; }
    .record-list > li { grid-template-columns: 1fr; gap: 6px; }
    .prose :global(pre) { font-size: 11px; }
    .prose :global(.collection-map) { padding: 18px; }
    .prose :global(.collection-tasks) { grid-template-columns: 1fr; }
  }
  @media print {
    .story { width: 100%; padding: 0; }
    .story-nav, .story-progress, .story-begin { display: none; }
    .story-grid { display: block; }
    .story-content { max-width: none; }
    .record-list > li { break-inside: avoid; }
    .prose :global(.chapter::before) { transform: none !important; }
  }
  @media (prefers-reduced-motion: reduce) {
    .prose :global(.chapter::before) { transform: none !important; transition: none; }
  }
</style>
