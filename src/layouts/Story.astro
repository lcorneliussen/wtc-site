---
import Base from './Base.astro';

interface Props {
  frontmatter: { title: string; description: string; author: string; updated: string };
}
const { frontmatter } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<Base title={`${frontmatter.title} | taba`} description={frontmatter.description}>
  <div class="story-progress" role="progressbar" aria-label="Reading progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-story-progress hidden><span></span></div>
  <main class="wrap story" id="main" data-story>
    <header class="story-header">
      <h1>{frontmatter.title}<span class="brand-dot">.</span></h1>
      <p class="story-byline">By {frontmatter.author} <span aria-hidden="true">/</span> First draft</p>
    </header>
    <article class="story-content" aria-label={frontmatter.title}>
      <div class="prose"><slot /></div>
    </article>
    <section class="story-next" aria-label="Next steps">
      <div><a class="button" href={`${base}docs/collections/`}>Try taba <span aria-hidden="true">→</span></a><a class="text-link" href={`${base}docs/getting-started/`}>Get started <span aria-hidden="true">→</span></a></div>
    </section>
  </main>
</Base>
<script>
  import '../scripts/story';
</script>
<style>
  .story { max-width: 1160px; padding-block: 50px 80px; }
  .story-header { display: flex; align-items: baseline; justify-content: space-between; gap: 25px; margin-bottom: 35px; }
  h1 { font: 650 clamp(52px, 6vw, 76px)/1.08 var(--display); letter-spacing: -.06em; margin: 0; }
  .story-byline { color: var(--muted); font-size: 11px; margin: 0; }
  .story-byline span { padding-inline: 8px; }
  .story-content { min-width: 0; }
  .prose { font-size: 16px; line-height: 1.85; }
  .prose :global(.problem-timeline) { list-style: none; margin: 0; padding: 0; }
  .prose :global(.problem) { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); grid-template-rows: auto auto; column-gap: 90px; align-content: center; min-height: 75svh; padding-block: 85px; border-bottom: 1px solid var(--line); scroll-margin-top: 130px; }
  .prose :global(.problem-date) { grid-column: 1; grid-row: 1; margin: 0 0 22px; color: var(--muted); font: 11px/1.8 var(--mono); }
  .prose :global(.problem-body) { grid-column: 1; grid-row: 2; min-width: 0; }
  .prose :global(.problem h2) { font: 650 clamp(38px, 4.8vw, 68px)/1.08 var(--display); letter-spacing: -.055em; color: var(--ink); margin: 0 0 25px; }
  .prose :global(.problem-subline) { max-width: 470px; font-size: 18px; line-height: 1.7; margin: 0 0 25px; color: #5d7064; }
  .prose :global(.scene-art) { grid-column: 2; grid-row: 1 / 3; align-self: center; transform: translate3d(0, var(--art-y, 0px), 0) rotate(var(--art-tilt, 0deg)); }
  .prose :global(.scene-art img) { display: block; width: 100%; height: auto; max-width: 510px; margin-inline: auto; }
  .prose :global(.problem:nth-child(even) .problem-date), .prose :global(.problem:nth-child(even) .problem-body) { grid-column: 2; }
  .prose :global(.problem:nth-child(even) .scene-art) { grid-column: 1; }
  .prose :global(.problem:has(details[open]) .scene-art) { position: sticky; top: 140px; align-self: start; }
  .prose :global(.problem-detail) { margin-top: 0; }
  .prose :global(.problem-detail summary) { display: inline-flex; align-items: center; gap: 10px; list-style: none; cursor: pointer; font: 12px/1.8 var(--mono); color: var(--green); text-decoration: underline; text-underline-offset: 5px; }
  .prose :global(.problem-detail summary::-webkit-details-marker) { display: none; }
  .prose :global(.problem-detail summary svg) { width: 22px; height: 22px; padding: 5px; border: 1px solid #b7c7a3; border-radius: 50%; transition: transform .2s; }
  .prose :global(.problem-detail[open] summary svg) { transform: rotate(180deg); }
  .prose :global(.when-open) { display: none; }
  .prose :global(.problem-detail[open] .when-open) { display: inline; }
  .prose :global(.problem-detail[open] .when-closed) { display: none; }
  .prose :global(.detail-copy) { border-top: 1px solid var(--line); padding-top: 8px; margin-top: 26px; font-size: 15px; }
  .prose :global(.detail-copy p) { margin-block: 20px; }
  .prose :global(.record-links) { border-top: 1px solid var(--line); margin-top: 30px; padding-top: 18px; font-size: 11px; line-height: 1.8; }
  .prose :global(.record-links > span) { display: block; font: 9px/1.8 var(--mono); color: var(--muted); margin-bottom: 7px; }
  .prose :global(.record-links ul) { list-style: none; padding: 0; margin: 0; }
  .prose :global(.record-links li) { margin-top: 8px; }
  .prose :global(.post-card) { margin: 30px 0; padding: 23px; border: 1px solid #d0d9c5; background: #fbfcf7; border-radius: 14px; font-size: 13px; }
  .prose :global(.post-author) { display: flex; align-items: center; gap: 10px; }
  .prose :global(.post-avatar) { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: #e3ebd5; color: var(--green); font: 11px var(--mono); }
  .prose :global(.post-author strong) { display: block; font-size: 12px; color: var(--ink); }
  .prose :global(.post-author small) { display: block; color: var(--muted); font-size: 10px; }
  .prose :global(.post-card blockquote) { margin: 19px 0; padding: 0; border: 0; background: none; color: var(--ink); font-size: 16px; line-height: 1.7; }
  .prose :global(.post-meta) { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px; font-size: 10px; color: var(--muted); }
  .prose :global(.story-rail) { position: sticky; top: 0; z-index: 20; width: var(--rail-width); margin-inline: calc((100% - var(--rail-width)) / 2); height: 96px; overflow: clip; background: var(--paper); border-block: 1px solid var(--line); }
  .prose :global(.rail-track) { position: absolute; top: 0; left: 0; display: flex; width: max-content; height: 100%; transform: translate3d(var(--rail-shift, 0px), 0, 0); will-change: transform; }
  .prose :global(.rail-track::before), .prose :global(.rail-track::after) { content: ''; position: absolute; left: calc(var(--rail-step) / 2); right: calc(var(--rail-step) / 2); top: 54px; height: 1px; background: #c5d0b6; }
  .prose :global(.rail-track::after) { background: var(--green); height: 2px; transform: scaleX(var(--rail-progress, 0)); transform-origin: left; }
  .prose :global(.rail-track a) { position: relative; flex: 0 0 var(--rail-step); display: grid; grid-template-rows: 14px 16px; gap: 12px; justify-items: center; align-items: center; padding-top: 20px; height: 100%; text-decoration: none; color: var(--muted); font: 11px/14px var(--mono); }
  .prose :global(.rail-dot) { width: 9px; height: 9px; border-radius: 50%; border: 1px solid #91a17b; background: var(--paper); z-index: 1; }
  .prose :global(.rail-track a[aria-current="step"]) { color: var(--green); }
  .prose :global(.rail-track a[aria-current="step"] .rail-dot) { background: var(--green); border-color: var(--green); }
  .prose :global(.rail-cursor) { position: absolute; left: calc(50% - 1px); top: 70px; height: 15px; width: 2px; background: var(--green); }
  .prose :global(.rail-cursor::before) { content: ''; position: absolute; left: -4px; top: -5px; border-inline: 5px solid transparent; border-bottom: 5px solid var(--green); }
  .prose :global(.story-rail.is-reduced .rail-cursor) { display: none; }
  .prose :global(.story-rail.is-reduced .rail-track) { width: 100%; transform: none; }
  .prose :global(.story-rail.is-reduced .rail-track a) { flex-basis: calc(100% / var(--chapters)); font-size: 9px; }
  .story-next { padding-top: 35px; }
  .story-next > div { display: flex; flex-wrap: wrap; gap: 25px; align-items: center; }
  @media (max-width: 900px) { .prose :global(.problem) { column-gap: 40px; } }
  @media (max-width: 700px) {
    .story { padding-top: 35px; }
    .story-header { display: block; margin-bottom: 28px; }
    h1 { margin-bottom: 18px; }
    .prose :global(.problem) { grid-template-columns: minmax(0, 1fr); row-gap: 0; min-height: 0; padding-block: 48px 55px; }
    .prose :global(.problem .problem-date), .prose :global(.problem:nth-child(even) .problem-date) { grid-column: 1; grid-row: 1; margin-bottom: 20px; }
    .prose :global(.problem .problem-body), .prose :global(.problem:nth-child(even) .problem-body) { grid-column: 1; grid-row: 2; }
    .prose :global(.problem h2) { font-size: clamp(36px, 9.5vw, 48px); }
    .prose :global(.problem-subline) { font-size: 16px; }
    .prose :global(.problem .scene-art), .prose :global(.problem:nth-child(even) .scene-art), .prose :global(.problem:has(details[open]) .scene-art) { grid-column: 1; grid-row: 3; position: static; margin-top: 28px; }
    .prose :global(.scene-art img) { max-width: 300px; }
    .prose :global(.story-rail) { height: 86px; }
    .prose :global(.rail-track a) { font-size: 10px; }
    .prose :global(.rail-cursor) { height: 9px; }
    .prose :global(.story-rail.is-reduced .rail-year) { display: none; }
    .prose :global(.story-rail.is-reduced .rail-track a) { font-size: 8px; }
    .prose :global(.post-card) { padding: 18px; }
  }
  @media (prefers-reduced-motion: reduce) { .prose :global(.scene-art), .prose :global(.problem-detail summary svg) { transform: none !important; transition: none; } }
  @media print { .prose :global(.story-rail) { display: none; } .prose :global(.problem) { min-height: 0; padding-block: 30px; break-inside: avoid; } .prose :global(.scene-art) { position: static; transform: none; } }
</style>
