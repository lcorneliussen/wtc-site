---
import Base from './Base.astro';

interface Props {
  frontmatter: { title: string; description: string; updated: string };
}
const { frontmatter } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<Base title={`${frontmatter.title} — taba`} description={frontmatter.description}>
  <main class="wrap announcement" id="main">
    <article>
      <header class="announcement-header">
        <p class="eyebrow">A NEW NAME FOR THE WHOLE TASK</p>
        <h1>{frontmatter.title}<span class="brand-dot">.</span></h1>
        <p class="announcement-description">{frontmatter.description}</p>
        <p class="announcement-updated">Updated <time datetime={frontmatter.updated}>{new Date(`${frontmatter.updated}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}</time></p>
      </header>
      <div class="prose"><slot /></div>
      <div class="doc-footer">
        <a href={`${base}docs/getting-started/`}>Getting started →</a>
        <a href={`${base}docs/upgrades/`}>Upgrades and release notes →</a>
      </div>
    </article>
  </main>
</Base>
<style>
  .announcement { max-width: 820px; padding-block: 72px 90px; }
  .announcement-header { margin-bottom: 38px; padding-bottom: 30px; border-bottom: 1px solid var(--line); }
  h1 { font-family: var(--display); font-size: clamp(40px, 5vw, 64px); font-weight: 650; letter-spacing: -.055em; line-height: 1.12; margin: 0 0 22px; }
  .announcement-description { color: var(--muted); font-size: 19px; line-height: 1.7; max-width: 620px; }
  .announcement-updated { color: var(--muted); font: 11px var(--mono); margin: 24px 0 0; }
  .prose :global(h2) { margin-top: 46px; font-size: 29px; letter-spacing: -1px; }
  .prose :global(h3) { margin-top: 30px; }
  .prose :global(li) { margin-block: 8px; }
  .prose :global(blockquote) { margin-inline: 0; padding-block: 8px; }
  @media (max-width: 600px) {
    .announcement { padding-block: 45px 60px; }
    .announcement-description { font-size: 17px; }
    .prose :global(h2) { font-size: 26px; }
  }
</style>
