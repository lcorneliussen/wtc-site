---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title = 'taba — Make room for the whole task.', description = 'Git worktree collections for working across repositories, with agents or your favorite editor. A little structure. A lot more room to work. Formerly wtc.' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content={description}>
  <meta name="theme-color" content="#f7f7f0">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <title>{title}</title>
  <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml">
  <link rel="canonical" href={new URL(Astro.url.pathname.replace(/\/404\/$/, '/404.html'), Astro.site)}>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header wrap">
    <a class="brand" href={base} aria-label="taba home"><span class="brand-mark" lang="ja" aria-hidden="true">束</span> <span>taba<span class="brand-dot">.</span></span></a>
    <nav aria-label="Main navigation">
      <a href={`${base}#how-it-works`}>How it works</a>
      <a href={`${base}why-taba/`} aria-current={Astro.url.pathname.endsWith('/why-taba/') ? 'page' : undefined}>Why taba</a>
      <a href={`${base}docs/getting-started/`}>Docs</a>
      <a class="github-link" href="https://github.com/lcorneliussen/wtc-cli">GitHub <span aria-hidden="true">↗</span></a>
    </nav>
    <a class="button button-small header-cta" href={`${base}docs/getting-started/`}>Get started <span aria-hidden="true">↗</span></a>
  </header>
  <slot />
  <footer class="wrap"><a class="brand" href={base} aria-label="taba home"><span class="brand-mark" lang="ja" aria-hidden="true">束</span> <span>taba<span class="brand-dot">.</span></span></a><span>A little structure. A lot more room to work.</span><a href="https://github.com/lcorneliussen/wtc-site">Site source <span aria-hidden="true">↗</span></a><a href="https://github.com/lcorneliussen/wtc-cli">GitHub <span aria-hidden="true">↗</span></a></footer>
</body>
</html>
